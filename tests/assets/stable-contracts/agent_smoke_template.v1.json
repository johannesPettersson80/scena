{
  "schema": "scena.agent_smoke_template.v1",
  "name": "product-configurator",
  "status": "ready",
  "required_features": [
    "inspection"
  ],
  "files": [
    {
      "kind": "recipe",
      "path": "target/scena-agent/product-configurator/recipe.json",
      "schema": "scena.scene_recipe.v1"
    },
    {
      "kind": "appearance_expectation",
      "path": "target/scena-agent/product-configurator/appearance-expectation.json",
      "schema": "scena.appearance_expectation.v1"
    }
  ],
  "commands": [
    {
      "name": "validate_recipe",
      "argv": [
        "scena",
        "validate-recipe",
        "target/scena-agent/product-configurator/recipe.json"
      ],
      "expected_schema": "scena.scene_recipe_validation.v1",
      "expected_ok": true,
      "artifacts": []
    },
    {
      "name": "verify_appearance",
      "argv": [
        "scena",
        "verify",
        "appearance",
        "target/scena-agent/product-configurator/recipe.json",
        "--expect",
        "target/scena-agent/product-configurator/appearance-expectation.json",
        "--out",
        "target/scena-agent/product-configurator/appearance.png"
      ],
      "expected_schema": "scena.appearance_introspection.v1",
      "expected_ok": true,
      "artifacts": [
        "target/scena-agent/product-configurator/appearance.png"
      ]
    }
  ],
  "notes": []
}
