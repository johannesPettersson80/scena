    {
      "action": "pick",
      "x_css_px": 16.0,
      "y_css_px": 16.0,
      "coordinate_space": "physical",
      "expect_hit": true,
      "expected_events": [
        "pick"
      ]
    },
    {
      "action": "pick",
      "x_css_px": 64.0,
      "y_css_px": 64.0,
      "coordinate_space": "css",
      "expect_hit": true,
