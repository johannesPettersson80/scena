      "x_css_px": 64.0,
      "y_css_px": 64.0,
      "coordinate_space": "css",
      "expect_hit": true,
      "expected_handle": 42,
      "expect_hover": true,
      "expected_events": [
        "hover"
      ]
    },
    {
      "action": "hover",
      "x_css_px": 1.0,
      "y_css_px": 1.0,
      "coordinate_space": "css",
      "expect_hit": false,
      "expect_hover": false,
      "expected_events": [
        "hover"
      ]
    },
    {
      "action": "select",
      "x_css_px": 64.0,
