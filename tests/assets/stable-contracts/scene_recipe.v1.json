          0.0,
          0.0,
          0.0
        ]
      },
      "label_offset": [
        0.25,
        0.25,
        0.0
      ]
    }
  ],
  "exploded_view": {
    "import": "part",
    "mode": "axis",
    "axis": [
      1.0,
      0.0,
      0.0
    ],
    "factor": 0.0,
    "distance": 0.0
