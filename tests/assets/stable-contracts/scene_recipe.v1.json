{
  "schema": "scena.scene_recipe.v1",
  "imports": [
    {
      "id": "part",
      "uri": "tests/assets/gltf/mesh_material_vertex_color_scene.gltf",
      "expected_extent": {
        "min": 0.1,
        "max": 10.0,
        "unit": "m"
      }
    }
  ],
  "colors": {
    "instance_tint": "#F6C85F",
    "label_bg": "#1D2733",
    "label_fg": "#FFFFFF",
    "pbr_white": "#FFFFFF",
    "attenuation_blue": "#BFD7FF",
    "plate_blue": "#3A7BD5"
  },
  "geometries": [
    {
      "id": "plate_geo",
      "primitive": {
        "kind": "box",
        "size": [
          0.12,
          0.06,
          0.004
        ]
      }
    }
  ],
  "materials": [
    {
      "id": "plate_mat",
      "kind": "pbr_metallic_roughness",
      "base_color": "plate_blue",
      "metallic": 0.0,
      "roughness": 0.42,
      "clearcoat_factor": 0.8,
      "clearcoat_roughness_factor": 0.16,
      "sheen_color_factor": "pbr_white",
      "sheen_roughness_factor": 0.35,
      "anisotropy_strength_factor": 0.65,
      "anisotropy_rotation_radians": 0.3,
      "iridescence_factor": 0.45,
      "iridescence_ior": 1.45,
      "iridescence_thickness_minimum_nm": 120.0,
      "iridescence_thickness_maximum_nm": 480.0,
      "dispersion_factor": 0.02,
      "transmission_factor": 0.18,
      "ior": 1.52,
      "thickness_factor": 0.05,
      "attenuation_distance": 2.5,
      "attenuation_color": "attenuation_blue"
    }
  ],
  "nodes": [
    {
      "id": "plate",
      "geometry": "plate_geo",
      "material": "plate_mat",
      "name": "CAD plate",
      "transform": {
        "kind": "center"
      }
    }
  ],
  "instance_sets": [
    {
      "id": "plate_instances",
      "geometry": "plate_geo",
      "material": "plate_mat",
      "instances": [
        {
          "id": "visible-copy",
          "transform": {
            "kind": "trs",
            "translation": [
              -0.08,
              0.0,
              0.0
            ]
          },
          "tint": "instance_tint"
        },
        {
          "id": "hidden-copy",
          "transform": {
            "kind": "trs",
            "translation": [
              0.08,
              0.0,
              0.0
            ]
          },
          "visible": false
        }
      ]
    }
  ],
  "labels": [
    {
      "id": "status_label",
      "text": "OK",
      "color": "label_fg",
      "background": "label_bg",
      "size_px": 18.0,
      "transform": {
        "kind": "trs",
        "translation": [
          0.0,
          0.08,
          0.0
        ]
      }
    }
  ],
  "clipping_planes": [
    {
      "id": "front_clip",
      "normal": [
        0.0,
        0.0,
        1.0
      ],
      "distance": 0.5
    }
  ],
  "animations": [
    {
      "id": "plate_slide",
      "duration": 1.0,
      "channels": [
        {
          "target": {
            "kind": "node",
            "id": "plate"
          },
          "path": "translation",
          "interpolation": "linear",
          "times": [
            0.0,
            1.0
          ],
          "values": [
            [
              0.0,
              0.0,
              0.0
            ],
            [
              0.04,
              0.0,
              0.0
            ]
          ]
        }
      ]
    }
  ],
  "cameras": [
    {
      "id": "main",
      "kind": "perspective",
      "fov_degrees": 40.0,
      "active": true,
      "transform": {
        "kind": "look_at",
        "eye": [
          0.2,
          0.15,
          0.2
        ],
        "target": "plate"
      }
    }
  ],
  "scene": {
    "background": {
      "kind": "studio"
    },
    "environment": {
      "kind": "default"
    },
    "grid": {
      "padding": 0.05,
      "line_spacing": 0.04
    }
  },
  "render": {
    "profile": "balanced",
    "quality": "medium",
    "anti_aliasing": "fxaa",
    "exposure_ev": 0.0,
    "tonemapper": "pbr_neutral"
  },
  "section_box": {
    "import": "part",
    "margin": 0.125,
    "inverted": false,
    "helper_wireframe": true
  },
  "measurements": [
    {
      "id": "part-width",
      "kind": "distance",
      "start": [
        -0.5,
        0.0,
        0.0
      ],
      "end": [
        0.5,
        0.0,
        0.0
      ],
      "label": "part width",
      "unit": "m",
      "precision": 2
    }
  ],
  "callouts": [
    {
      "id": "part-callout",
      "text": "Part",
      "target": {
        "kind": "import_root",
        "import": "part",
        "local_offset": [
          0.0,
          0.0,
          0.0
        ]
      },
      "label_offset": [
        0.25,
        0.25,
        0.0
      ]
    }
  ],
  "exploded_view": {
    "import": "part",
    "mode": "axis",
    "axis": [
      1.0,
      0.0,
      0.0
    ],
    "factor": 0.0,
    "distance": 0.0
  },
  "expect": {
    "expect_color": [
      {
        "id": "plate-color",
        "target": {
          "kind": "node",
          "id": "plate"
        },
        "swatch_srgb8": [
          58,
          123,
          213
        ],
        "tolerance": 0.2
      }
    ],
    "expect_bbox_fit": {
      "min": 0.05,
      "max": 0.95
    },
    "expect_pick": [
      {
        "id": "plate-pick",
        "x_css_px": 48.0,
        "y_css_px": 36.0,
        "target": {
          "kind": "node",
          "id": "plate"
        }
      }
    ]
  },
  "capture": {
    "width": 96,
    "height": 72
  },
  "metadata": {
    "purpose": "stable recipe fixture"
  }
}
